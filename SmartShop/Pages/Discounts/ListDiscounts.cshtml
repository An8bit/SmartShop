@page "/list-discounts"
@model SmartShop.Web.Pages.Discounts.ListDiscountsModel
@{
    ViewData["Title"] = "Danh sách chương trình giảm giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="mb-3">@ViewData["Title"]</h1>
<div class="mb-3">
    <a href="/create-discounts" class="btn btn-primary">+ Thêm mã giảm giá</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" class="mb-3">
    <label>
        <input type="checkbox" name="showActiveOnly" value="true" @(Model.ShowActiveOnly ? "checked" : "") onchange="this.form.submit()" />
        Chỉ hiển thị giảm giá đang hoạt động
    </label>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Sản phẩm</th>
            <th>Phần trăm giảm</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Ngày cập nhật</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var discount in Model.Discounts)
        {
            <tr>
                <td>@discount.DiscountId</td>
                <td>@discount.ProductName</td>
                <td>@discount.DiscountPercentage %</td>
                <td>@discount.StartDate.ToString("dd/MM/yyyy")</td>
                <td>@discount.EndDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (discount.IsActive)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Không hoạt động</span>
                    }
                </td>
                <td>@discount.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@discount.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form method="post" asp-page-handler="ToggleStatus" class="d-inline">
                        <input type="hidden" name="id" value="@discount.DiscountId" />
                        <input type="hidden" name="isActive" value="@discount.IsActive" />
                        <button type="submit" class="btn btn-sm btn-warning">
                            @(discount.IsActive ? "Tắt" : "Bật")
                        </button>
                    </form>

                    <form method="post" asp-page-handler="Delete" class="d-inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa chương trình giảm giá này không?');">
                        <input type="hidden" name="id" value="@discount.DiscountId" />
                        <button type="submit" class="btn btn-sm btn-danger">Xoá</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
