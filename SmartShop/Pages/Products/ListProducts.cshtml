@page "/list-products"
@model SmartShop.Web.Pages.Products.ProductsModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-box text-primary me-2"></i>
        Quản lý sản phẩm
    </h1>
    <div>
        <a href="/create-product" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 me-1"></i>
            Thêm sản phẩm mới
        </a>
        <button class="btn btn-success btn-sm shadow-sm ms-2" onclick="exportToExcel()">
            <i class="fas fa-download fa-sm text-white-50 me-1"></i>
            Xuất Excel
        </button>
    </div>
</div>

<!-- Stats Cards Row -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Tổng sản phẩm
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @(Model.Products?.Count() ?? 0)
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-box fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Tổng tồn kho
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @(Model.Products?.SelectMany(p => p.Variants ?? new List<SmartShop.Core.DTOs.VariantDto>()).Sum(v => v.StockQuantity) ?? 0)
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-warehouse fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Danh mục
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @(Model.Products?.Select(p => p.CategoryName).Distinct().Count() ?? 0)
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-tags fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Giá trị trung bình
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @((Model.Products?.Any() == true ? Model.Products.Average(p => p.Price) : 0).ToString("N0")) VND
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Products Table Card -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table me-2"></i>
                Danh sách sản phẩm
            </h6>
            <div class="dropdown no-arrow">
                <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in" aria-labelledby="dropdownMenuLink">
                    <div class="dropdown-header">Hành động:</div>
                    <a class="dropdown-item" href="#" onclick="refreshTable()">
                        <i class="fas fa-sync fa-sm fa-fw mr-2 text-gray-400"></i>
                        Làm mới
                    </a>
                    <a class="dropdown-item" href="#" onclick="exportToExcel()">
                        <i class="fas fa-download fa-sm fa-fw mr-2 text-gray-400"></i>
                        Xuất Excel
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="productsTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th>Danh mục</th>
                            <th>Variants</th>
                            <th>Tổng tồn kho</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Products != null && Model.Products.Any())
                        {
                            int stt = 1;
                            foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td>
                                        <img src="@(product.ImageUrl ?? "/images/default-product.png")" 
                                             alt="@product.Name" 
                                             style="width: 80px; height: 80px; object-fit: cover;" 
                                             class="img-thumbnail"
                                             onerror="this.src='/images/default-product.png'">
                                    </td>
                                    <td>
                                        <div class="fw-bold">@(product.Name ?? "N/A")</div>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <small class="text-muted">@product.Description</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-success">@product.Price.ToString("N0") VND</div>
                                        @if (product.OriginalPrice.HasValue && product.OriginalPrice != product.Price)
                                        {
                                            <small class="text-muted text-decoration-line-through">@product.OriginalPrice.Value.ToString("N0") VND</small>
                                        }
                                        @if (product.DiscountPercentage.HasValue)
                                        {
                                            <br><span class="badge bg-danger">-@product.DiscountPercentage.Value.ToString("0")%</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@(product.CategoryName ?? "N/A")</span>
                                    </td>
                                    <td>
                                        @if (product.Variants != null && product.Variants.Any())
                                        {
                                            <div class="small">
                                                @foreach (var variant in product.Variants.Take(3))
                                                {
                                                    <div class="mb-1">
                                                        <span class="badge bg-secondary me-1">@variant.Color</span>
                                                        <span class="badge bg-info me-1">@variant.Size</span>
                                                        <span class="text-muted">(@variant.StockQuantity)</span>
                                                    </div>
                                                }
                                                @if (product.Variants.Count > 3)
                                                {
                                                    <small class="text-muted">+@(product.Variants.Count - 3) variants khác...</small>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có variants</span>
                                        }
                                    </td>
                                    <td>
                                        @if (product.Variants != null && product.Variants.Any())
                                        {
                                            <span class="fw-bold text-primary">@product.Variants.Sum(v => v.StockQuantity)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td>@product.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-page="./Details" asp-route-id="@product.ProductId" class="btn btn-info btn-sm" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-page="./Edit" asp-route-id="@product.ProductId" class="btn btn-warning btn-sm" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@product.ProductId" 
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');" style="display:inline;">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">Không có sản phẩm nào</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

@section Scripts {
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    
    <!-- SheetJS for Excel export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        let productsTable;
        
        $(document).ready(function () {
            // Initialize DataTable
            productsTable = $('#productsTable').DataTable({
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'
                },
                columnDefs: [
                    { orderable: false, targets: [1, 5, 8] }, // Hình ảnh, Variants, Thao tác
                    { searchable: false, targets: [0, 1, 8] }, // STT, Hình ảnh, Thao tác
                    { width: "5%", targets: 0 }, // STT
                    { width: "10%", targets: 1 }, // Hình ảnh
                    { width: "20%", targets: 2 }, // Tên sản phẩm
                    { width: "12%", targets: 3 }, // Giá
                    { width: "8%", targets: 4 }, // Danh mục
                    { width: "20%", targets: 5 }, // Variants
                    { width: "8%", targets: 6 }, // Tổng tồn kho
                    { width: "10%", targets: 7 }, // Ngày tạo
                    { width: "7%", targets: 8 } // Thao tác
                ],
                order: [[0, 'asc']], // Sắp xếp theo STT
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>t<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                drawCallback: function(settings) {
                    // Re-initialize tooltips after table redraw
                    $('[data-bs-toggle="tooltip"]').tooltip();
                }
            });

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });

        // Export to Excel function
        function exportToExcel() {
            // Get table data
            const table = document.getElementById('productsTable');
            const wb = XLSX.utils.table_to_book(table, {sheet: "Products"});
            
            // Generate filename with current date
            const date = new Date().toISOString().slice(0, 10);
            const filename = `DanhSachSanPham_${date}.xlsx`;
            
            // Save file
            XLSX.writeFile(wb, filename);
            
            // Show success message
            showToast('Xuất Excel thành công!', 'success');
        }

        // Refresh table function
        function refreshTable() {
            location.reload();
        }

        // Toast notification function
        function showToast(message, type = 'info') {
            const toast = $(`
                <div class="toast align-items-center text-white bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `);
            
            // Add to toast container (create if doesn't exist)
            if ($('#toast-container').length === 0) {
                $('body').append('<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }
            
            $('#toast-container').append(toast);
            toast.toast('show');
            
            // Remove after hiding
            toast.on('hidden.bs.toast', function () {
                $(this).remove();
            });
        }

        // Confirm delete function
        function confirmDelete(productId, productName) {
            if (confirm(`Bạn có chắc chắn muốn xóa sản phẩm "${productName}"?`)) {
                // Submit delete form
                $(`form[data-product-id="${productId}"]`).submit();
            }
        }
    </script>

    <style>
        .border-left-primary {
            border-left: 0.25rem solid #4e73df !important;
        }
        .border-left-success {
            border-left: 0.25rem solid #1cc88a !important;
        }
        .border-left-info {
            border-left: 0.25rem solid #36b9cc !important;
        }
        .border-left-warning {
            border-left: 0.25rem solid #f6c23e !important;
        }
        .text-gray-800 {
            color: #5a5c69 !important;
        }
        .text-gray-300 {
            color: #dddfeb !important;
        }
        .shadow-sm {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
        }
        .shadow {
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15) !important;
        }
        .animated--fade-in {
            animation: fadeIn 0.2s ease-in-out;
        }
        @@keyframes fadeIn {
            0% { opacity: 0; }
            100% { opacity: 1; }
        }
        
        /* DataTables custom styling */
        .dataTables_wrapper .dataTables_length select {
            padding: 0.375rem 1.75rem 0.375rem 0.75rem;
        }
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #d1d3e2;
            border-radius: 0.35rem;
            padding: 0.375rem 0.75rem;
        }
        .table th {
            border-top: none;
            background-color: #f8f9fc;
            font-weight: 800;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1rem;
            color: #858796;
        }
    </style>
}