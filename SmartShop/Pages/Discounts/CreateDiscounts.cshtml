@page "/create-discounts"
@model SmartShop.Web.Pages.Discounts.CreateModel
@{
    ViewData["Title"] = "Tạo chương trình giảm giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Tạo chương trình giảm giá</h4>
        </div>

        <div class="card-body">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Discount.ProductId" class="form-label">Sản phẩm</label>
                    <select asp-for="Discount.ProductId" class="form-select" asp-items="Model.Products">
                        <option value="">-- Chọn sản phẩm --</option>
                    </select>
                    <span asp-validation-for="Discount.ProductId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Discount.DiscountPercentage" class="form-label">Phần trăm giảm giá (%)</label>
                    <input asp-for="Discount.DiscountPercentage" class="form-control" placeholder="Nhập số % giảm giá..." />
                    <span asp-validation-for="Discount.DiscountPercentage" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Discount.StartDate" class="form-label">Ngày bắt đầu</label>
                        <input asp-for="Discount.StartDate" type="date" class="form-control" />
                        <span asp-validation-for="Discount.StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Discount.EndDate" class="form-label">Ngày kết thúc</label>
                        <input asp-for="Discount.EndDate" type="date" class="form-control" />
                        <span asp-validation-for="Discount.EndDate" class="text-danger"></span>
                    </div>
                </div>

                
                <div class="d-flex justify-content-between mt-4">
                    <a asp-page="./ListDiscounts" class="btn btn-outline-secondary">← Quay lại danh sách</a>
                    <button type="submit" class="btn btn-primary">💾 Tạo giảm giá</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
