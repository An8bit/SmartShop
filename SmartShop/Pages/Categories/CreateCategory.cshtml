@page "/create-categories"
@model SmartWeb.Pages.Categories.CreateModel
@{
    ViewData["Title"] = "Thêm danh mục mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Thêm danh mục mới</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<form method="post" >
    <div class="form-group">
        <label asp-for="Category.CategoryName" class="control-label">Tên danh mục</label>
        <input asp-for="Category.CategoryName" class="form-control" />
        <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Category.Description" class="control-label">Mô tả</label>
        <textarea asp-for="Category.Description" class="form-control"></textarea>
        <span asp-validation-for="Category.Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Category.ParentCategoryId" class="control-label">Danh mục cha</label>
        <select asp-for="Category.ParentCategoryId" class="form-control"
                asp-items="Model.ParentCategories">
            <option value="">-- Không chọn --</option>
        </select>
        <span asp-validation-for="Category.ParentCategoryId" class="text-danger"></span>
    </div>

    <button asp-page-handler="Create" type="submit" class="btn btn-primary">Thêm danh mục</button>
    <a asp-page="./Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
